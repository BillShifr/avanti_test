{
  "name": "avanti-home",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build:laravel": "vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "preview:serve": "vite preview --config vite.preview.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"resources/**/*.{css,vue}\"",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "structure": "node tools/structure_check.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual --project=chromium-desktop --project=chromium-mobile",
    "test:visual": "playwright test --grep @visual",
    "quality:frontend": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm structure && pnpm test:unit"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.7.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "laravel-vite-plugin": "^3.2.0",
    "lefthook": "^2.1.14",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
